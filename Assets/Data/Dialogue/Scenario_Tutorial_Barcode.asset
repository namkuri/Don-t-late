  m_Name: Scenario_Tutorial_Barcode
  m_EditorClassIdentifier: Assembly-CSharp::DontLate.DialogueScenarioSO
  lines:
  - speaker: "\uC0AC\uC7A5\uB2D8"
    text: "\uC790, \uC774\uC81C \uC9C4\uC9DC \uC77C\uC774\uB2E4. \uC9D0\uC740 \uBC14\uCF54\uB4DC\uB97C
      \uCC0D\uC5B4\uC57C \uC2E4\uC744 \uC218 \uC788\uC5B4.\n\uC0C1\uC790 \uAC00\uAE4C\uC774
      \uAC00\uC11C \uB9C8\uC6B0\uC2A4\uB85C \uC0C1\uC790\uB97C \uD074\uB9AD\uD574\uBD10.
      \uC1A1\uC7A5\uC774 \uB730 \uAC70\uC57C.\n\uAC70\uAE30 \uBC14\uCF54\uB4DC\uC5D0
      \uB9C8\uC6B0\uC2A4\uB97C \uAC16\uB2E4 \uB300\uBA74 \uD3F0\uC774 \uC800\uC808\uB85C
      \uC62C\uB77C\uC640. \uADF8 \uC0C1\uD0DC\uB85C\n\uCE74\uBA54\uB77C \uD55C\uAC00\uC6B4\uB370\uC5D0
      \uBC14\uCF54\uB4DC\uB97C \uB9DE\uCD94\uACE0 \uC7A0\uAE50 \uC788\uC73C\uBA74
      \u2014 \uCC30\uCE75, \uC54C\uC544\uC11C \uCC0D\uD78C\uB2E4."
    portrait: {fileID: 0}
