  m_Script: {fileID: 11500000, guid: a5e3ef5ec1efc4b4397e1c503ec59084, type: 3}
  m_Name: Scenario_Tutorial_Area
  m_EditorClassIdentifier: Assembly-CSharp::DontLate.DialogueScenarioSO
  lines:
  - speaker: "\uC0AC\uC7A5\uB2D8"
    text: "\uAD6C\uC5ED\uC740 \uB137\uC774\uC57C. \uBE4C\uB77C\uCD0C, \uBA39\uC790\uACE8\uBAA9,
      \uC544\uD30C\uD2B8\uB2E8\uC9C0, \uC5B8\uB355\uC8FC\uD0DD\uAC00.\n\uBA39\uC790\uACE8\uBAA9\uC740
      \uC0AC\uB78C\uB3C4 \uB9CE\uACE0 \uB178\uC810\uB3C4 \uB9CE\uC544 \u2014 \uBC30
      \uACE0\uD504\uBA74 \uAC70\uAE30\uC11C \uBB50 \uC0AC \uBA39\uC5B4\uB3C4 \uB418\uACE0.\n\uC5B8\uB355\uC740
      \uBE44 \uC624\uBA74 \uBBF8\uB044\uB7EC\uC6B0\uB2C8\uAE4C \uADF8\uB7F0 \uB0A0\uC740
      \uD2B9\uD788 \uC870\uC2EC\uD558\uACE0. \uC544\uD30C\uD2B8\uB294 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB791\n\uD604\uAD00
      \uBE44\uBC00\uBC88\uD638\uAC00 \uC788\uC5B4. \uD5F7\uAC08\uB9AC\uBA74 \uD3F0
      \uC9C0\uB3C4 \uBCF4\uBA74 \uB3FC, \uB2E4 \uB098\uC640 \uC788\uC73C\uB2C8\uAE4C."
    portrait: {fileID: 0}
