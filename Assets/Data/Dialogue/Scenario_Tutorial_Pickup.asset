  m_Script: {fileID: 11500000, guid: a5e3ef5ec1efc4b4397e1c503ec59084, type: 3}
  m_Name: Scenario_Tutorial_Pickup
  m_EditorClassIdentifier: Assembly-CSharp::DontLate.DialogueScenarioSO
  lines:
  - speaker: "\uC0AC\uC7A5\uB2D8"
    text: "\uC2A4\uCE94\uD588\uC73C\uBA74 \uC774\uC81C \uB4E4\uBA74 \uB3FC. \uC0C1\uC790
      \uC55E\uC5D0\uC11C E\uB97C \uB20C\uB7EC\uBD10."
    portrait: {fileID: 0}
  - speaker: "\uC0AC\uC7A5\uB2D8"
    text: "\uC774 \uAC74\uC740 \uBE4C\uB77C\uCD0C\uC774\uC57C. \uACE8\uBAA9 \uBAA8\uD241\uC774
      \uB3CC\uC544\uC11C \uC591\uC625\uC9D1 \uCABD\uC73C\uB85C \uAC00\uBA74"
    portrait: {fileID: 0}
  - speaker: "\uC0AC\uC7A5\uB2D8"
    text: "\uBC14\uB2E5\uC774 \uC740\uC740\uD558\uAC8C \uBE5B\uB098\uB294 \uC790\uB9AC\uAC00
      \uC788\uC744 \uAC70\uC57C \u2014 \uAC70\uAE30\uAC00 \uB0B4\uB824\uB193\uB294
      \uB370\uB2E4."
    portrait: {fileID: 0}
  - speaker: "\uC0AC\uC7A5\uB2D8"
    text: "\uBB34\uAC70\uC6B0\uBA74 \uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0, \uCC9C\uCC9C\uD788
      \uAC00\uB3C4 \uAD1C\uCC2E\uC544."
    portrait: {fileID: 0}
